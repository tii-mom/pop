{
  "name": "pop-box-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build:shared": "pnpm --filter @pop-box/shared build",
    "build:contracts": "pnpm --filter @pop-box/contracts compile",
    "test:contracts": "pnpm --filter @pop-box/contracts test",
    "test:shared": "pnpm --filter @pop-box/shared test",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean"
  }
}

# Server
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# Database & Redis
DATABASE_URL=postgresql://popbox:popbox_dev_pass@localhost:5432/popbox?schema=public
REDIS_URL=redis://localhost:6379

# Auth & Encryption (replace with 32-byte random hex in production)
JWT_SECRET=dev_jwt_secret_change_me_in_production_at_least_32_bytes_long
POOL_SALT_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Telegram Bot & Mini App
TELEGRAM_BOT_TOKEN=
TELEGRAM_MINIAPP_URL=https://app.popbox.example

# BSC Chain & Contracts
BSC_CHAIN_ID=56
BSC_RPC_URL=https://bsc-dataseed.binance.org/
POP_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
POP_PRIMARY_SALE_ADDRESS=0x0000000000000000000000000000000000000000
POP_CLAIM_VAULT_ADDRESS=0x0000000000000000000000000000000000000000
PANCAKE_V3_POOL_ADDRESS=0x0000000000000000000000000000000000000000
PANCAKE_V3_NPM_ADDRESS=0x46A15B0b27311cedF172AB29E4f4766fbE7F4364

# Four-Wallet Physical Isolation (TEAM_RESERVE_WALLET private key NEVER enters .env!)
HOT_CUSTODY_WALLET_ADDRESS=0x0000000000000000000000000000000000000000
HOT_CUSTODY_PRIVATE_KEY=
CLAIM_SIGNER_PRIVATE_KEY=

# Market & Risk Config
MARKET_FEE_BPS=400
TURNSTILE_SECRET_KEY=

# LLM Quiz Generator (Gemini 2.5 Flash or OpenAI-compatible)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash

# Worker Toggles
ENABLE_WORKERS=false
